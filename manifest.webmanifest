{
  "id": "./",
  "name": "PizzaLab Scientifico - Calcolatore Pizza",
  "short_name": "PizzaLab",
  "description": "Calcolatore scientifico per impasti pizza, reologia inversa, cinetica fermentativa e termodinamica TFI.",
  "lang": "it",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "background_color": "#0f141c",
